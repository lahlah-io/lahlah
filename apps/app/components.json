{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/shared/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/shared/components",
    "utils": "@/shared/utils/cn",
    "ui": "@/shared/components/ui",
    "lib": "@/shared/utils",
    "hooks": "@/shared/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@reactbits-pro": {
      "url": "https://pro.reactbits.dev/api/r/pro/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REACTBITS_PRO_LICENSE_KEY}"
      }
    },
    "@mapcn": "https://mapcn.dev/r/{name}.json"
  }
}
