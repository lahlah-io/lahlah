# Base URL API Lahlah. Biarkan kosong untuk memakai http://localhost:8787.
VITE_API_BASE_URL=http://localhost:8787
# Public client ID PeridotID (contoh: pidapp_...). Wajib untuk login Google.
VITE_PERIDOT_CLIENT_ID=
# Tampilkan fallback token dev di halaman login ("true"/kosong). Kosongkan di production.
VITE_ALLOW_DEV_TOKEN=true
