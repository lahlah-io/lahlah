{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "prisma", "src/generated"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:session": "tsx src/scripts/dev-session.ts",
    "build": "prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:container": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:expire-subscriptions": "tsx src/scripts/expire-subscriptions.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.6.1",
    "hono": "^4.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.5",
    "typescript": "7.0.2"
  }
}
