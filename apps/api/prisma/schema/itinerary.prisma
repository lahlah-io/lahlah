enum ItineraryStatus {
  draft
  confirmed
  archived
  cancelled
}

model Itinerary {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  sessionId      String?                @unique @map("session_id") @db.Uuid // keep 1:1
  currentVersion Int                    @default(1) @map("current_version")
  tripDate       DateTime?              @map("trip_date") @db.Date
  durationDays   Int                    @default(1) @map("duration_days")
  city           String                 @default("Padang") @db.VarChar(100)
  transportMode  String?                @map("transport_mode") @db.VarChar
  title          String                 @db.VarChar
  content        String                 @db.Text
  status         ItineraryStatus        @default(draft)
  isPublic       Boolean                @default(false) @map("is_public")
  shareSlug      String?                @unique @map("share_slug") @db.VarChar
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  session        ChatSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  destinations   ItineraryDestination[] // KEEP for legacy compat
  versions       ItineraryVersion[]
  drafts         ItineraryDraft[]

  @@map("itinerary")
}

model ItineraryDestination {
  id            String                  @id @default(uuid()) @db.Uuid
  itineraryId   String                  @map("itinerary_id") @db.Uuid
  destinationId String                  @map("destination_id") @db.Uuid
  position      Int?
  isActive      Boolean                 @default(true) @map("is_active")
  visitAt       DateTime?               @map("visit_at") @db.Timestamptz
  estimatedCost Float?                  @map("estimated_cost")
  notes         String?                 @db.Text
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  itinerary     Itinerary               @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination   Destination             @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  checkpoints   DestinationCheckpoint[]

  @@index([itineraryId, visitAt])
  @@index([itineraryId, isActive])
  @@map("itinerary_destinations")
}

model DestinationCheckpoint {
  id                     String               @id @default(uuid()) @db.Uuid
  itineraryDestinationId String               @map("itinerary_destination_id") @db.Uuid
  userId                 String               @map("user_id") @db.Uuid
  imageUrl               String               @map("image_url") @db.VarChar
  metadata               Json                 @default("{}")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  itineraryDestination   ItineraryDestination @relation(fields: [itineraryDestinationId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("destination_checkpoints")
}

model ItineraryVersion {
  id                String           @id @default(uuid()) @db.Uuid
  itineraryId       String           @map("itinerary_id") @db.Uuid
  version           Int
  basedOnVersion    Int?             @map("based_on_version")
  changeInstruction String?          @map("change_instruction") @db.Text
  changeType        String           @map("change_type") @db.VarChar
  totalDistanceM    Int?             @map("total_distance_m")
  totalDurationMin  Int?             @map("total_duration_min")
  totalEstimatedMin Int?             @map("total_estimated_min")
  status            String           @db.VarChar
  isSaved           Boolean          @default(false) @map("is_saved")
  isSelected        Boolean          @default(false) @map("is_selected")
  sourceMessageId   String?          @map("source_message_id") @db.Uuid
  routeJson         Json?            @map("route_json")
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  stops             ItineraryStop[]
  itinerary         Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  sourceMessage     ChatMessage?     @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@unique([itineraryId, version])
  @@index([itineraryId, version])
  @@index([itineraryId, isSelected])
  @@index([itineraryId, isSaved])
  @@map("itinerary_versions")
}

model ItineraryStop {
  id                 String           @id @default(uuid()) @db.Uuid
  itineraryVersionId String           @map("itinerary_version_id") @db.Uuid
  destinationId      String?          @map("destination_id") @db.Uuid
  position           Int
  name               String           @db.VarChar
  latitude           Decimal          @db.Decimal(10, 7)
  longitude          Decimal          @db.Decimal(10, 7)
  arrivalTime        String?          @map("arrival_time") @db.VarChar
  departureTime      String?          @map("departure_time") @db.VarChar
  visitDurationMin   Int?             @map("visit_duration_min")
  travelDurationMin  Int?             @map("travel_duration_min")
  notes              String?          @db.Text
  category           String?          @db.VarChar
  snapshotJson       Json?            @map("snapshot_json")
  version            ItineraryVersion @relation(fields: [itineraryVersionId], references: [id], onDelete: Cascade)
  destination        Destination?     @relation(fields: [destinationId], references: [id])

  @@unique([itineraryVersionId, position])
  @@index([itineraryVersionId, position])
  @@map("itinerary_stops")
}

model ItineraryDraft {
  id          String       @id @default(uuid()) @db.Uuid // exposed as draftId compat
  sessionId   String       @unique @map("session_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  itineraryId String?      @map("itinerary_id") @db.Uuid
  payload     Json
  status      String       @default("pending_confirmation") @db.VarChar
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz
  session     ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itinerary   Itinerary?   @relation(fields: [itineraryId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("itinerary_drafts")
}
