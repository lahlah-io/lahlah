model Trip {
  id            String    @id @default(uuid()) @db.Uuid
  chatSessionId String?   @unique @map("chat_session_id") @db.Uuid
  title         String    @db.VarChar
  isPublic      Boolean   @default(false) @map("is_public")
  shareSlug     String?   @unique @map("share_slug") @db.VarChar
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  session      ChatSession?      @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  members      UserTrip[]
  destinations TripDestination[]
  likes        TripLike[]
  views        TripView[]
  shares       TripShare[]

  @@map("trips")
}

model UserTrip {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  status    String?  @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
  @@index([userId])
  @@index([tripId])
  @@map("user_trips")
}

/// Satu baris = satu titik pada satu versi trip. Versi = kelompok baris dengan created_at sama.
model TripDestination {
  id            String    @id @default(uuid()) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  visitAt       DateTime? @map("visit_at") @db.Timestamptz
  estimatedCost Float?    @map("estimated_cost")
  distance      Float?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  trip        Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination             @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  checkpoints DestinationCheckpoint[]

  @@index([tripId, createdAt])
  @@index([tripId, visitAt])
  @@map("trip_destinations")
}

model DestinationCheckpoint {
  id                String          @id @default(uuid()) @db.Uuid
  tripDestinationId String          @map("trip_destination_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  imageUrl          String          @map("image_url") @db.VarChar
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  tripDestination   TripDestination @relation(fields: [tripDestinationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("destination_checkpoints")
}
