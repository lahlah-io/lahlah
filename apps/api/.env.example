# Copy to .env and fill in. Never commit real secrets.
PORT=8787
NODE_ENV=development

# PostgreSQL connection string used by Prisma (migrations) and the API runtime.
DATABASE_URL="postgresql://postgres:password@localhost:5432/lahlah?schema=public"

# PeridotID app credentials. Register the app in the PeridotID dashboard:
# client id starts with pidapp_, the backend secret with pidsk_.
PERIDOT_CLIENT_ID="pidapp_..."
PERIDOT_CLIENT_SECRET="pidsk_..."

# Random 32+ byte string used to pepper stored session token hashes.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_TOKEN_PEPPER=""
SESSION_TTL_DAYS=30

# Frontends allowed to call the API with credentials.
APP_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
