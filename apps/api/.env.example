DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/lahlah_db
PORT=8787
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info
# Public PeridotID app id (pidapp_...). Never put a client secret in client-side code.
PERIDOT_CLIENT_ID=CHANGE_ME
# Sandbox or production PeridotID environment. Must match where the app is registered.
PERIDOT_ENV=sandbox
# Required only if the PeridotID app has a backend secret set (pidsk_... shown once on rotate).
# PERIDOT_CLIENT_SECRET=CHANGE_ME
SESSION_TTL_DAYS=30
SESSION_TOKEN_PEPPER=CHANGE_ME_AT_LEAST_16_CHARS
# Comma-separated emails that are promoted to admin on login.
ADMIN_EMAILS=
# Kosongkan bila sumber tidak dipakai. Skrip melewati sumber tanpa kunci.
GEOAPIFY_API_KEY=
FIRECRAWL_API_KEY=
SCRAPE_CITY=Padang
SCRAPE_LIMIT=200
SCRAPE_USER_AGENT=LahlahBot/1.0 (admin@lahlah.local)

# AI (OpenAI-compatible). Keys boleh kosong saat start; panggilan gagal terkontrol.
AI_BASE_URL=
AI_API_KEY=
AI_PROVIDER=openai-compatible
AI_CLASSIFIER_MODEL=
AI_TOOL_MODEL=
AI_CLASSIFIER_BASE_URL=
AI_CLASSIFIER_API_KEY=
AI_CLASSIFIER_PROVIDER=
AI_TOOL_BASE_URL=
AI_TOOL_API_KEY=
AI_TOOL_PROVIDER=
AI_TOOL_MAX_ROUNDS=3
AI_CLASSIFIER_REASONING_EFFORT=low
AI_TOOL_REASONING_EFFORT=medium
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_TOP_K=3
EMBEDDING_SIMILARITY_THRESHOLD=0.3
DRAFT_TTL_SECONDS=1800
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000
OSRM_CACHE_TTL_HOURS=24
APIFY_TOKEN=
